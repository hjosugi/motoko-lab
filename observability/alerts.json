{
  "version": 1,
  "description": "Reviewed alert inventory for #24. docs/29_OBSERVABILITY.md is the design; this file is the machine-readable source of truth. scripts/check_observability.py fails CI when an alert is added, removed or re-thresholded here without the document and the runbook following, and when a critical alert has no runbook anchor that resolves.",
  "signals": {
    "cycle_runway_days": { "unit": "days", "direction": "below", "aggregate": "min", "source": "derived(cycles_balance, cycles_burn)" },
    "cycles_balance": { "unit": "cycles", "direction": "low", "aggregate": "sum", "source": "canister_status" },
    "cycles_burn": { "unit": "cycles/second", "direction": "high", "aggregate": "sum", "source": "balance delta over window" },
    "heap_bytes": { "unit": "bytes", "direction": "high", "aggregate": "sum", "source": "canister_status" },
    "stable_bytes": { "unit": "bytes", "direction": "high", "aggregate": "sum", "source": "canister_status" },
    "record_count": { "unit": "count", "direction": "grow", "aggregate": "sum", "source": "canister query" },
    "usage_event_count": { "unit": "count", "direction": "grow", "aggregate": "sum", "source": "canister query" },
    "failed_update_rate": { "unit": "ratio", "direction": "high", "aggregate": "max", "source": "reject counters" },
    "pending_payment_age_seconds": { "unit": "seconds", "direction": "high", "aggregate": "max", "source": "payment queue" },
    "index_lag_seconds": { "unit": "seconds", "direction": "high", "aggregate": "max", "source": "index high-water vs shard" },
    "growth_deviation": { "unit": "ratio", "direction": "high", "aggregate": "max", "source": "growth vs baseline" },
    "upgrade_smoke_failed": { "unit": "boolean", "direction": "high", "aggregate": "max", "source": "post-upgrade smoke test" },
    "telemetry_gap": { "unit": "boolean", "direction": "high", "aggregate": "max", "source": "scrape failure or silent shard" },
    "shard_silent": { "unit": "boolean", "direction": "high", "aggregate": "max", "source": "no sample from a shard" },
    "annotation_missing": { "unit": "boolean", "direction": "high", "aggregate": "max", "source": "module hash change without annotation" },
    "module_hash": { "unit": "hex64", "direction": "change", "aggregate": "unique", "source": "canister_status" }
  },
  "recorded_only": {
    "cycles_balance": "an input to cycle_runway_days; recorded so the runway arithmetic is auditable",
    "cycles_burn": "an input to cycle_runway_days; recorded so the runway arithmetic is auditable",
    "heap_bytes": "recorded for capacity review (#30); no threshold until a measured baseline exists",
    "stable_bytes": "recorded for capacity review (#30); no threshold until a measured baseline exists",
    "record_count": "recorded so growth is visible; growth_deviation carries the alert",
    "usage_event_count": "recorded so growth is visible; growth_deviation carries the alert",
    "module_hash": "recorded on every deployment; annotation_missing carries the alert"
  },
  "routes": {
    "pager": { "receiver": "primary-on-call", "channel": "icp-ops-pager", "ack_seconds": 300 },
    "ticket": { "receiver": "ops-queue", "channel": "github-issue" },
    "digest": { "receiver": "daily-digest", "channel": "email" }
  },
  "alerts": [
    {
      "id": "cycle-runway",
      "signal": "cycle_runway_days",
      "scope": "canister",
      "comparator": "below",
      "warning": 30,
      "critical": 7,
      "for_seconds": 300,
      "clear_seconds": 1800,
      "repeat_seconds": 21600,
      "route": "pager",
      "runbook": "docs/07_OPERATIONS_RUNBOOK.md#cycle-runway"
    },
    {
      "id": "index-lag",
      "signal": "index_lag_seconds",
      "scope": "index",
      "comparator": "above",
      "warning": 60,
      "critical": 600,
      "for_seconds": 60,
      "clear_seconds": 300,
      "repeat_seconds": 3600,
      "route": "pager",
      "runbook": "docs/07_OPERATIONS_RUNBOOK.md#index-lag"
    },
    {
      "id": "pending-payment-age",
      "signal": "pending_payment_age_seconds",
      "scope": "payment",
      "comparator": "above",
      "warning": 300,
      "critical": 1800,
      "for_seconds": 60,
      "clear_seconds": 300,
      "repeat_seconds": 3600,
      "route": "pager",
      "runbook": "docs/07_OPERATIONS_RUNBOOK.md#pending-payment-age"
    },
    {
      "id": "failed-update-rate",
      "signal": "failed_update_rate",
      "scope": "canister",
      "comparator": "above",
      "warning": 0.01,
      "critical": 0.05,
      "for_seconds": 300,
      "clear_seconds": 900,
      "repeat_seconds": 3600,
      "route": "pager",
      "runbook": "docs/07_OPERATIONS_RUNBOOK.md#failed-update-rate"
    },
    {
      "id": "archive-growth-deviation",
      "signal": "growth_deviation",
      "scope": "archive",
      "comparator": "above",
      "warning": 2,
      "critical": 5,
      "for_seconds": 3600,
      "clear_seconds": 7200,
      "repeat_seconds": 86400,
      "route": "ticket",
      "runbook": "docs/07_OPERATIONS_RUNBOOK.md#archive-growth-deviation"
    },
    {
      "id": "upgrade-smoke-failure",
      "signal": "upgrade_smoke_failed",
      "scope": "deployment",
      "comparator": "is_true",
      "warning": true,
      "critical": true,
      "for_seconds": 0,
      "clear_seconds": 0,
      "repeat_seconds": 3600,
      "route": "pager",
      "runbook": "docs/07_OPERATIONS_RUNBOOK.md#upgrade-smoke-failure"
    },
    {
      "id": "telemetry-gap",
      "signal": "telemetry_gap",
      "scope": "source",
      "comparator": "is_true",
      "warning": false,
      "critical": true,
      "for_seconds": 0,
      "clear_seconds": 0,
      "repeat_seconds": 1800,
      "route": "pager",
      "runbook": "docs/07_OPERATIONS_RUNBOOK.md#telemetry-gap"
    },
    {
      "id": "shard-silent",
      "signal": "shard_silent",
      "scope": "shard",
      "comparator": "is_true",
      "warning": false,
      "critical": true,
      "for_seconds": 0,
      "clear_seconds": 0,
      "repeat_seconds": 3600,
      "route": "pager",
      "runbook": "docs/07_OPERATIONS_RUNBOOK.md#silent-shard"
    },
    {
      "id": "deployment-annotation",
      "signal": "annotation_missing",
      "scope": "deployment",
      "comparator": "is_true",
      "warning": true,
      "critical": false,
      "for_seconds": 0,
      "clear_seconds": 0,
      "repeat_seconds": 86400,
      "route": "ticket",
      "runbook": "docs/07_OPERATIONS_RUNBOOK.md#deployment-annotation"
    }
  ]
}
