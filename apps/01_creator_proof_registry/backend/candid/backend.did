type AIDisclosure = record {
  assisted : bool;
  mode : variant { none; assist; generate; transform; other : text };
  provider : opt text;
  model : opt text;
  promptHash : opt blob;
  humanContribution : opt text;
};
type Error = variant {
  anonymousNotAllowed;
  unauthorized;
  notFound;
  invalidInput : text;
  duplicate : text;
  conflict : text;
  expired;
};
type CommitmentAlgorithm = variant { sha256V1 };
type CommitmentSpec = record {
  version : text;
  algorithm : CommitmentAlgorithm;
  domain : text;
  layout : text;
  digestSize : nat;
  minSaltSize : nat;
  maxSaltSize : nat;
  minPrincipalTextSize : nat;
  maxPrincipalTextSize : nat;
};
type CommitmentStatus = variant { open; revealed : nat; cancelled : nat };
type Commitment = record {
  id : nat;
  owner : principal;
  commitmentHash : blob;
  metadataHash : opt blob;
  committedAt : nat;
  expiresAt : opt nat;
  status : CommitmentStatus;
};
type RecordStatus = variant {
  active;
  revoked : record { at : nat; reason : text };
};
type ProofRecord = record {
  id : nat;
  commitmentId : nat;
  owner : principal;
  artifactHash : blob;
  manifestHash : blob;
  salt : blob;
  title : text;
  kind : text;
  mimeType : text;
  storageUri : text;
  parents : vec nat;
  ai : AIDisclosure;
  createdAt : nat;
  status : RecordStatus;
};
type CommitInput = record {
  commitmentHash : blob;
  metadataHash : opt blob;
  expiresAt : opt nat;
};
type RevealInput = record {
  commitmentId : nat;
  artifactHash : blob;
  manifestHash : blob;
  salt : blob;
  title : text;
  kind : text;
  mimeType : text;
  storageUri : text;
  parents : vec nat;
  ai : AIDisclosure;
  algorithm : opt CommitmentAlgorithm;
  collection : opt CollectionId;
};
type CertifiedRecord = record {
  "record" : ProofRecord;
  certificate : blob;
  witness : blob;
};
type CreatorId = nat;
type CollectionId = nat;
type DelegationId = nat;
type KeyRecord = record {
  "principal" : principal;
  activeFrom : nat;
  retiredAt : opt nat;
  reason : text;
};
type RecoveryPolicy = record {
  guardian : principal;
  delayNanos : nat;
  declaredAt : nat;
};
type Creator = record {
  id : CreatorId;
  root : principal;
  keys : vec KeyRecord;
  recovery : opt RecoveryPolicy;
  createdAt : nat;
};
type Collection = record {
  id : CollectionId;
  creator : CreatorId;
  name : text;
  createdAt : nat;
};
type Scope = variant { all; collection : CollectionId };
type DelegationStatus = variant {
  active;
  revoked : record { at : nat; reason : text };
};
type Delegation = record {
  id : DelegationId;
  creator : CreatorId;
  delegate : principal;
  scope : Scope;
  expiresAt : nat;
  createdAt : nat;
  status : DelegationStatus;
};
type RecoveryStatus = variant {
  pending;
  completed : nat;
  cancelled : record { at : nat; by : principal };
};
type Recovery = record {
  creator : CreatorId;
  proposedRoot : principal;
  requestedBy : principal;
  requestedAt : nat;
  effectiveAt : nat;
  status : RecoveryStatus;
};
type Authority = variant { root; delegated : DelegationId };
type Attribution = record {
  "record" : nat;
  creator : CreatorId;
  signer : principal;
  authority : Authority;
  collection : opt CollectionId;
};
type CreatorResult = variant { ok : Creator; err : Error };
type CollectionResult = variant { ok : Collection; err : Error };
type DelegationResult = variant { ok : Delegation; err : Error };
type RecoveryResult = variant { ok : Recovery; err : Error };
type CommitmentResult = variant { ok : Commitment; err : Error };
type RecordResult = variant { ok : ProofRecord; err : Error };
type Stats = record {
  commitments : nat;
  records : nat;
  activeRecords : nat;
  revokedRecords : nat;
};
type DisputeId = nat;
type DisputeError = variant {
  anonymousNotAllowed;
  unauthorized;
  notFound;
  invalidInput : text;
  duplicate : text;
  conflict : text;
  expired;
  rateLimited : record { retryAt : nat };
};
type Ground = variant {
  authorship;
  priorCreation;
  undisclosedDerivation;
  aiDisclosure;
  licensing;
  other;
};
type Locator = variant { uri : text; sealed : record { custodian : text } };
type Evidence = record { digest : blob; locator : Locator; description : text };
type Party = variant { claimant; respondent };
type Stance = variant { contest; concede; partial };
type Outcome = variant { upheld; rejected; settled; dismissed; abusive };
type Submission = record {
  by : principal;
  party : Party;
  evidence : Evidence;
  at : nat;
};
type Response = record {
  by : principal;
  stance : Stance;
  statement : text;
  at : nat;
};
type Determination = record {
  authority : principal;
  outcome : Outcome;
  summary : text;
  decision : opt Evidence;
  round : nat;
  at : nat;
};
type Appeal = record {
  by : principal;
  party : Party;
  statement : text;
  round : nat;
  at : nat;
};
type DisputeStatus = variant {
  open;
  responded;
  determined;
  appealed;
  withdrawn : record { at : nat; reason : text };
};
type Dispute = record {
  id : DisputeId;
  "record" : nat;
  claimant : principal;
  ground : Ground;
  statement : text;
  counterRecord : opt nat;
  evidence : vec Submission;
  filedAt : nat;
  respondBy : nat;
  response : opt Response;
  determinations : vec Determination;
  appeals : vec Appeal;
  round : nat;
  status : DisputeStatus;
  events : nat;
  head : blob;
};
type DisputeAction = variant {
  filed : record {
    "record" : nat;
    ground : Ground;
    statement : text;
    counterRecord : opt nat;
    evidence : vec Evidence;
  };
  responded : record { stance : Stance; statement : text; evidence : vec Evidence };
  evidenceAdded : record { party : Party; evidence : vec Evidence };
  determined : record {
    outcome : Outcome;
    summary : text;
    decision : opt Evidence;
    round : nat;
  };
  appealed : record {
    party : Party;
    statement : text;
    evidence : vec Evidence;
    round : nat;
  };
  withdrawn : record { reason : text };
};
type DisputeEvent = record {
  dispute : DisputeId;
  seq : nat;
  at : nat;
  by : principal;
  action : DisputeAction;
  prev : blob;
  hash : blob;
};
type DisputeAuthority = record {
  id : principal;
  name : text;
  policyUri : text;
  addedAt : nat;
  retiredAt : opt nat;
};
type FileDisputeInput = record {
  "record" : nat;
  ground : Ground;
  statement : text;
  counterRecord : opt nat;
  evidence : vec Evidence;
};
type RespondInput = record { stance : Stance; statement : text; evidence : vec Evidence };
type DetermineInput = record { outcome : Outcome; summary : text; decision : opt Evidence };
type AppealInput = record { statement : text; evidence : vec Evidence };
type DisputeSummary = record {
  "record" : nat;
  total : nat;
  unresolved : nat;
  determined : nat;
  withdrawn : nat;
  conflicting : nat;
};
type DisputeExport = record {
  format : text;
  canister : principal;
  "record" : ProofRecord;
  dispute : Dispute;
  events : vec DisputeEvent;
  authorities : vec DisputeAuthority;
  certificate : blob;
  witness : blob;
};
type DisputeResult = variant { ok : Dispute; err : DisputeError };
type DisputeAuthorityResult = variant { ok : DisputeAuthority; err : DisputeError };
service : {
  commit : (CommitInput) -> (CommitmentResult);
  cancelCommitment : (nat) -> (CommitmentResult);
  reveal : (RevealInput) -> (RecordResult);
  revokeRecord : (nat, text) -> (RecordResult);
  getCommitment : (nat) -> (opt Commitment) query;
  getRecord : (nat) -> (opt ProofRecord) query;
  getRecordCertified : (nat) -> (opt CertifiedRecord) query;
  getByArtifactHash : (blob) -> (opt ProofRecord) query;
  listRecords : (nat, nat) -> (vec ProofRecord) query;
  commitmentSpec : () -> (CommitmentSpec) query;
  registerCreator : () -> (CreatorResult);
  rotateKey : (principal, text) -> (CreatorResult);
  declareRecovery : (principal, nat) -> (CreatorResult);
  beginRecovery : (nat, principal) -> (RecoveryResult);
  cancelRecovery : (nat) -> (RecoveryResult);
  confirmRecovery : (nat) -> (CreatorResult);
  createCollection : (text) -> (CollectionResult);
  createDelegation : (principal, Scope, nat) -> (DelegationResult);
  revokeDelegation : (nat, text) -> (DelegationResult);
  getCreator : (nat) -> (opt Creator) query;
  getCollection : (nat) -> (opt Collection) query;
  getDelegation : (nat) -> (opt Delegation) query;
  getRecovery : (nat) -> (opt Recovery) query;
  attribution : (nat) -> (opt Attribution) query;
  addDisputeAuthority : (principal, text, text) -> (DisputeAuthorityResult);
  retireDisputeAuthority : (principal) -> (DisputeAuthorityResult);
  listDisputeAuthorities : () -> (vec DisputeAuthority) query;
  fileDispute : (FileDisputeInput) -> (DisputeResult);
  respondToDispute : (nat, RespondInput) -> (DisputeResult);
  addDisputeEvidence : (nat, vec Evidence) -> (DisputeResult);
  determineDispute : (nat, DetermineInput) -> (DisputeResult);
  appealDispute : (nat, AppealInput) -> (DisputeResult);
  withdrawDispute : (nat, text) -> (DisputeResult);
  getDispute : (nat) -> (opt Dispute) query;
  listDisputes : (nat, nat, nat) -> (vec Dispute) query;
  disputeEvents : (nat) -> (vec DisputeEvent) query;
  disputeSummary : (nat) -> (DisputeSummary) query;
  exportDispute : (nat) -> (opt DisputeExport) query;
  stats : () -> (Stats) query;
};
