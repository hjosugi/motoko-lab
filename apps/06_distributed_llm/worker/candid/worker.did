type WorkerReply = 
 record {
   bytes: nat;
   hi: nat;
   lo: nat;
   reply: Reply;
   shard: nat;
 };
type WorkerInfo = 
 record {
   hi: nat;
   lo: nat;
   shard: nat;
   shardCount: nat;
   vocabSize: nat;
 };
type ShardRequest = 
 record {
   ctx: Ctx;
   mode: ReplyMode;
   order: nat;
   range: opt Range;
 };
type Rounding = 
 variant {
   floor;
   nearest;
 };
type Result = 
 variant {
   err: Error;
   ok: WorkerInfo;
 };
type ReplyMode = 
 variant {
   argmax;
   dense;
   quantized: record {
                bits: nat;
                rounding: Rounding;
              };
 };
type Reply = 
 variant {
   argmax: record {
             score: nat;
             token: nat;
           };
   dense: record {
            lo: nat;
            scores: vec nat;
          };
   quantized: record {
                codes: Quantized;
                lo: nat;
                rounding: Rounding;
              };
 };
type Range = 
 record {
   hi: nat;
   lo: nat;
 };
type Quantized = 
 record {
   bits: nat;
   codes: vec nat;
   scale: nat;
 };
type Nanos = nat;
type Fault = 
 variant {
   disagreement: record {
                   shard: nat;
                   workers: record {
                              nat;
                              nat;
                            };
                 };
   missing: record {shard: nat;};
   spotCheckFailed: record {
                      shard: nat;
                      worker: nat;
                    };
   wrongRange: record {
                 expected: Range;
                 got: Range;
                 shard: nat;
               };
 };
type Exceeded = 
 record {
   limit: nat;
   requested: nat;
   resetInNanos: Nanos;
   used: nat;
 };
type Error = 
 variant {
   anonymousNotAllowed;
   faultyWorker: Fault;
   invalidInput: text;
   lowCycles: record {
                balance: nat;
                reserve: nat;
              };
   notConfigured: text;
   quotaExceeded: Exceeded;
   unauthorized;
   workerFailed: text;
 };
type Ctx = 
 record {
   prev1: opt nat;
   prev2: opt nat;
 };
/// Shard worker canister.
/// 
/// Deploy this source once per shard (`worker_0`, `worker_1`, ... in
/// `icp.yaml`). Each instance is told which slice of the vocabulary it owns by
/// the orchestrator, then answers scoring requests for that slice only.
/// 
/// Every scoring endpoint is a `query`: a worker never mutates model state, so
/// the orchestrator can reach it without paying for consensus on the worker
/// side. The orchestrator itself must still be an update call, because a query
/// cannot make an inter-canister call.
service : {
  /// First caller claims the worker; afterwards only that principal may
  /// reconfigure it. Anonymous callers are rejected so an unclaimed worker
  /// cannot be captured by anyone who can reach the boundary node.
  configure: (shard: nat, count: nat) -> (Result);
  info: () -> (WorkerInfo) query;
  /// Scores a vocabulary range for one decoding position.
  /// 
  /// The range is the worker's own slice unless the request names another one.
  /// Answering somebody else's slice is what makes replicated scoring possible,
  /// and it gives nothing away: the model is baked into every worker's wasm, the
  /// reply names the range it covers, and it is the orchestrator that decides
  /// whether two answers about one range are allowed to differ.
  score: (request: ShardRequest) -> (WorkerReply) query;
}
