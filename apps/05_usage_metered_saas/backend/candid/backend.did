type UsageInput =
 record {
   category: text;
   idempotencyKey: text;
   tenant: principal;
   units: nat;
 };
type UsageEvent =
 record {
   category: text;
   id: nat;
   idempotencyKey: text;
   recordedAt: nat;
   recordedBy: principal;
   tenant: principal;
   units: nat;
 };
type TenantInput =
 record {
   displayName: text;
   plan: Plan;
   "principal": principal;
 };
type Tenant =
 record {
   createdAt: nat;
   displayName: text;
   enabled: bool;
   periodStartedAt: nat;
   plan: Plan;
   "principal": principal;
   used: nat;
 };
type Stats =
 record {
   apiKeys: nat;
   reporters: nat;
   tenants: nat;
   usageEvents: nat;
 };
type SignedReceipt =
 record {
   receipt: Receipt;
   signature: blob;
 };
type PrincipalScope =
 variant {
   any;
   only: vec principal;
 };
type TextScope =
 variant {
   any;
   only: vec text;
 };
type Result_6 =
 variant {
   err: Error;
   ok: UsageEvent;
 };
type Result_5 =
 variant {
   err: Error;
   ok: ReporterKey;
 };
type Result_4 =
 variant {
   err: Error;
   ok: ApiKeyRecord;
 };
type Result_3 =
 variant {
   err: Error;
   ok: bool;
 };
type Result_2 =
 variant {
   err: Error;
   ok: ReporterPolicy;
 };
type Result_1 =
 variant {
   err: Error;
   ok: Tenant;
 };
type Result =
 variant {
   err: Error;
   ok: vec ReceiptOutcome;
 };
type ReporterView =
 record {
   enabled: bool;
   health: ReporterHealth;
   keys: vec ReporterKey;
   policy: opt ReporterPolicy;
   reporter: principal;
 };
type ReporterPolicy =
 record {
   categories: TextScope;
   maxUnitsPerEvent: nat;
   maxUnitsPerWindow: nat;
   requireSignatures: bool;
   tenants: PrincipalScope;
   windowSeconds: nat;
 };
type ReporterKey =
 record {
   addedAt: nat;
   id: nat;
   publicKey: blob;
   reporter: principal;
   status: KeyStatus;
 };
type ReporterHealth =
 record {
   accepted: nat;
   anomalous: bool;
   badSignatures: nat;
   lastRejection: opt record {
                        at: nat;
                        reason: text;
                      };
   outOfScope: nat;
   rejected: nat;
   rejectedInWindow: nat;
   replayed: nat;
   windowExceeded: nat;
   windowStart: nat;
   windowUnits: nat;
 };
type ReceiptSpec =
 record {
   canister: principal;
   curve: text;
   domain: text;
   maxAgeNanos: nat;
   maxBatch: nat;
   maxFutureSkewNanos: nat;
   signatureEncoding: text;
 };
type ReceiptRejection =
 variant {
   badSignature;
   conflict: text;
   future;
   invalidReceipt: text;
   keyNotValid;
   outOfScope: text;
   quotaExceeded: record {
                    quota: nat;
                    requested: nat;
                    used: nat;
                  };
   stale;
   tenantUnavailable;
   unauthorized;
   unknownKey;
   windowExceeded: record {
                     limit: nat;
                     requested: nat;
                     used: nat;
                   };
   wrongCanister;
 };
type ReceiptOutcome =
 variant {
   recorded: UsageEvent;
   rejected: ReceiptRejection;
   replayed: UsageEvent;
 };
type Receipt =
 record {
   canister: principal;
   category: text;
   idempotencyKey: text;
   keyId: nat;
   observedAt: nat;
   reporter: principal;
   tenant: principal;
   units: nat;
 };
type Plan =
 record {
   currency: text;
   name: text;
   periodSeconds: nat;
   priceMinorUnits: nat;
   quota: nat;
 };
type LineKind =
 variant {
   subscription;
   usage: text;
 };
type Line =
 record {
   amount: nat;
   kind: LineKind;
   quantity: nat;
 };
type KeyStatus =
 variant {
   active;
   compromised: nat;
   retired: nat;
 };
type InvoiceView =
 record {
   adjustments: vec InvoiceAdjustment;
   balance: int;
   invoice: Invoice;
   ledger: opt BillingLedger;
   payTo: Account;
   payments: vec InvoicePayment;
   status: InvoiceStatus;
 };
type InvoiceStatus =
 variant {
   creditBalance;
   paid;
   partiallyPaid;
   unpaid;
 };
type InvoicePayment =
 record {
   amount: nat;
   appliedAt: nat;
   block: nat;
   decimals: nat8;
   from: Account;
   invoice: nat;
   ledger: principal;
   paidAt: nat;
   symbol: text;
 };
type InvoiceAdjustment =
 record {
   amount: nat;
   at: nat;
   by: principal;
   id: nat;
   invoice: nat;
   kind: AdjustmentKind;
   reason: text;
   reference: text;
 };
type Invoice =
 record {
   billedUntil: nat;
   closedAt: nat;
   currency: text;
   eventIds: vec nat;
   id: nat;
   lateEvents: nat;
   lines: vec Line;
   paymentMemo: blob;
   periodStart: nat;
   plan: Plan;
   reason: CloseReason;
   sequence: nat;
   tenant: principal;
   total: nat;
 };
type Error =
 variant {
   anonymousNotAllowed;
   conflict: text;
   duplicate: text;
   invalidInput: text;
   notFound;
   quotaExceeded: record {
                    quota: nat;
                    requested: nat;
                    used: nat;
                  };
   unauthorized;
 };
type CloseReason =
 variant {
   periodEnd;
   planChange;
 };
type InvoiceResult =
 variant {
   err: BillingError;
   ok: InvoiceView;
 };
type BillingLedgerResult =
 variant {
   err: BillingError;
   ok: BillingLedger;
 };
type BillingLedger =
 record {
   decimals: nat8;
   fee: nat;
   ledger: principal;
   registeredAt: nat;
   symbol: text;
 };
type BillingError =
 variant {
   anonymousNotAllowed;
   conflict: text;
   duplicate: text;
   invalidInput: text;
   ledgerUnavailable: text;
   notFound;
   rejected: text;
   unauthorized;
 };
type AuditEntry =
 record {
   event: UsageEvent;
   publicKey: opt blob;
   receipt: opt SignedReceipt;
 };
type ApiKeyRecord =
 record {
   createdAt: nat;
   hash: blob;
   keyLabel: text;
   revokedAt: opt nat;
   tenant: principal;
 };
type AdjustmentKind =
 variant {
   credit;
   debit;
 };
type AdjustmentInput =
 record {
   amount: nat;
   kind: AdjustmentKind;
   reason: text;
   reference: text;
 };
type Account =
 record {
   owner: principal;
   subaccount: opt blob;
 };
service : {
  /// Registers a signing key for a reporter. Controllers only: a reporter that
  /// could add its own keys would let a stolen principal mint one.
  addReporterKey: (reporter: principal, publicKey: blob) -> (Result_5);
  /// Appends a credit or debit note. The invoice is not edited and nothing is
  /// deleted. `reference` is the operator's own id for the adjustment: a retry
  /// with the same reference and content returns the adjustment already made,
  /// and the same reference with different content is refused.
  adjustInvoice: (invoiceId: nat, input: AdjustmentInput) ->
   (InvoiceResult);
  /// Closes the tenant's period if it has ended, without waiting for the next
  /// usage event to do it. A period that has not ended cannot be closed here;
  /// one that has is closed exactly once, by whichever call comes first.
  closePeriod: (tenantPrincipal: principal) -> (InvoiceResult);
  createTenant: (input: TenantInput) -> (Result_1);
  /// Usage events with their receipts and signing keys, for an auditor who
  /// wants to re-verify billing without trusting this canister.
  exportUsageAudit: (start: nat, limit: nat) -> (vec AuditEntry) query;
  getApiKey: (hash: blob) -> (opt ApiKeyRecord) query;
  getInvoice: (invoiceId: nat) -> (opt InvoiceView) query;
  getReporter: (reporter: principal) -> (opt ReporterView) query;
  getTenant: ("principal": principal) -> (opt Tenant) query;
  getUsageEvent: (id: nat) -> (opt UsageEvent) query;
  /// The invoice as the customer-readable JSON document in docs/BILLING.md.
  invoiceJson: (invoiceId: nat) -> (opt text) query;
  listInvoices: (tenantPrincipal: principal) -> (vec Invoice) query;
  listUsageEvents: (start: nat, limit: nat) -> (vec UsageEvent) query;
  /// Declares a key stolen: nothing it signed is accepted any more, whatever
  /// time the receipt claims. The reporter may do this itself as well as a
  /// controller — it can only make the key less useful, never more.
  markReporterKeyCompromised: (keyId: nat) -> (Result_5);
  /// Applies a ledger payment to an invoice. The caller supplies a block
  /// index; every property of the payment is read from the ledger.
  ///
  /// Safe to repeat: the same block for the same invoice returns the invoice
  /// as paid and applies nothing twice, and a ledger that cannot be asked
  /// changes nothing. Everything is re-checked after the ledger call, because
  /// another message may have applied the same block while this one waited.
  payInvoice: (invoiceId: nat, ledger: principal, block: nat) ->
   (InvoiceResult);
  /// The rules a signer has to follow, read off the canister rather than
  /// hardcoded, including the `canister` every receipt must name.
  receiptSpec: () -> (ReceiptSpec) query;
  /// The unsigned path. A reporter whose policy requires signatures is refused
  /// here, so a stolen principal cannot route around them; any other reporter
  /// with a policy is held to its scope and window on this path too.
  /// Controllers are operators, not reporters, and are not policy-bound.
  recordUsage: (input: UsageInput) -> (Result_6);
  registerApiKeyHash: (tenantPrincipal: principal, hash: blob, keyLabel:
   text) -> (Result_4);
  /// Registers a ledger invoices in its symbol can be paid with, reading the
  /// symbol, decimals and fee from the ledger itself. Controllers only: which
  /// tokens settle invoices is operator policy, and a registered ledger is
  /// trusted to report its own history.
  registerBillingLedger: (ledger: principal) -> (BillingLedgerResult);
  /// Rotates a key out. Receipts it signed before now still verify.
  retireReporterKey: (keyId: nat) -> (Result_5);
  revokeApiKeyHash: (hash: blob) -> (Result_4);
  setReporter: (reporter: principal, enabled: bool) -> (Result_3);
  setReporterPolicy: (reporter: principal, policy: ReporterPolicy) ->
   (Result_2);
  setTenantEnabled: (tenantPrincipal: principal, enabled: bool) -> (Result_1);
  setTenantPlan: (tenantPrincipal: principal, plan: Plan) -> (Result_1);
  stats: () -> (Stats) query;
  /// Submits signed receipts — typically an offline batch, signed where the
  /// usage was observed and relayed later by the reporter.
  submitReceipts: (batch: vec SignedReceipt) -> (Result);
}
